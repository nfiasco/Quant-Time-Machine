# Backend settings. Copy this file to backend/.env (git-ignored) and fill in your own values.
# Never commit real keys. app/config.py reads these, and real environment variables win over this file.

# FRED/ALFRED API key (free). Sign in to FRED, then request a key at
# https://fredaccount.stlouisfed.org/apikeys. It is a 32-character string of lowercase letters and digits.
FRED_API_KEY=

# SEC EDGAR requires every automated client to identify itself with a name and a contact email;
# requests without one are refused (HTTP 403). Use your own details, for example:
# SEC_USER_AGENT="Quant Time Machine (UD CISC 498) jdoe@udel.edu"
SEC_USER_AGENT=

# Tiingo API token, for daily prices (decision D2). Create a free Tiingo account, then copy the
# token from https://www.tiingo.com/account/api/token. The free plan is for internal use only.
TIINGO_API_KEY=

# Where raw downloads and the local point-in-time store live. Git-ignored.
# A relative path is resolved from backend/.
DATA_DIR=./data

# Browser origins allowed to call the API (CORS), separated by commas: exact origins with
# no trailing slash. Defaults to http://localhost:3000. Vercel preview deployments each have
# their own URL; add any you need.
CORS_ORIGINS=http://localhost:3000,https://quant-time-machine-uy5f.vercel.app

# Raw Tiingo prices are for internal use only (decision D2), so GET /v1/prices answers 403
# unless this is true. Turn it on for local development; never on a deployment other
# people can reach, until display rights are settled.
# SERVE_RAW_PRICES=true

# Optional: only the price-source spike (spikes/prices.py) reads this.
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=
