# Frontend settings. Copy this file to frontend/.env.local (git-ignored) and adjust.
# NEXT_PUBLIC_ variables are built into the JavaScript sent to browsers, so never put secrets here.
# After changing one, restart `npm run dev` (or rebuild, for production).

# Base URL of the backend API, read by lib/api/client.ts. Production on Vercel uses the
# deployed API, https://quant-time-machine-api.up.railway.app; you can point at it here to
# try the web app without running the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth: project Settings > API. Use the publishable key (sb_publishable_...)
# or the legacy public anon key. Secret/service-role keys are rejected by the app.
# Leave blank to show the explicit "Accounts unavailable" state.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted frontend origin used in confirmation and recovery emails. Set this for
# each deployment, and add its /auth/callback URL to Supabase's redirect allow-list.
# This is server-only; never construct email links from a caller-supplied Host header.
SITE_URL=http://localhost:3000
