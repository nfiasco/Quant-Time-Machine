# Frontend settings. Copy this file to frontend/.env.local (git-ignored) and adjust.
# NEXT_PUBLIC_ variables are built into the JavaScript sent to browsers, so never put secrets here.
# After changing one, restart `npm run dev` (or rebuild, for production).

# Base URL of the backend API, read by lib/api/client.ts. Production on Vercel uses the
# deployed API, https://quant-time-machine-api.up.railway.app; you can point at it here to
# try the web app without running the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
